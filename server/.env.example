# PATIENT ZERO 계정 서버 설정 — 실제 값은 server/.env 에 두고 저장소에 올리지 않는다.
# 비어 있는 수단은 **꺼진 채로** 뜬다(/api/config 가 알려 주고, 화면이 비활성으로 그린다).

PORT=4190
DATA=/var/lib/patient-zero/accounts.json

# ── 구글 ──────────────────────────────────────────────
# 웹(브라우저)과 안드로이드가 같은 **웹 클라이언트 ID** 를 쓴다.
# 안드로이드는 serverClientId 로 이 값을 넘겨야 ID 토큰이 나온다(안드로이드 클라이언트 ID 로는 안 나온다).
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# ── 애플 ──────────────────────────────────────────────
# iOS 네이티브는 **번들 ID** 가 aud 로 온다. 웹(Sign in with Apple JS)은 **Services ID** 다.
# 둘 다 쓸 거면 APPLE_AUD 에 쉼표로 적는다. SHIPPING.md §3 의 「콘솔에서 틀린 값 넷」을 먼저 볼 것.
APPLE_BUNDLE_ID=sarl.patientzero.app
# 아래 셋은 **웹 흐름을 열 때만** 채운다. 1차 출시(iOS 네이티브만)에서는 비워 둔다 —
# 비워 두면 SHIPPING.md §3 의 「콘솔에서 틀린 값 넷」을 하나도 밟지 않고, 6개월마다 비밀을 갈 일도 없다.
APPLE_SERVICES_ID=
APPLE_REDIRECT=
APPLE_AUD=

# ── 메일 코드 ─────────────────────────────────────────
# Resend 의 HTTP API 로 보낸다(SMTP 아님 — copycat 이 거기서 한참 헤맸다).
RESEND_API_KEY=
# 메일 제목·본문에 적히는 이름. **비우면 「막차 이후」가 나간다**(서버 코드를 거기서 가져왔다)
# (systemd EnvironmentFile 은 값 뒤의 인라인 주석을 안 떼어낸다 — 주석은 줄을 따로 쓴다)
MAIL_APP_NAME="최초 감염자"
MAIL_FROM=

# ── 심사용 데모 계정 ──────────────────────────────────
# 메일을 실제로 보내지 않고 들어갈 수 있는 한 쌍. 심사원에게 그대로 적어 준다(2.1 대비).
# 이 값은 App Review Notes 와 STORE.md 에 공개로 적힌다 — 비밀이 아니다.
# 대신 **이 계정에는 아무것도 넣지 않는다**(데모 저장 한 벌뿐). 둘 중 하나라도 비면 데모는 닫힌다.
DEMO_EMAIL=review@copycat.sarl
DEMO_CODE=503118
