# home.165-227-196-68.sslip.io 블록 **안에** 넣는다 — 새 호스트를 만들지 않는다.
# 이 박스에서는 트레이딩 루프가 같이 돈다. `systemctl reload caddy` 가 실패하면 그쪽이 같이 다치므로
# 넣기 전에 반드시 `caddy validate --config /etc/caddy/Caddyfile` 로 확인하고, diff 를 먼저 보여 줄 것.

handle /patient-zero/api/* {
    uri strip_prefix /patient-zero
    reverse_proxy 127.0.0.1:4190
}
